# examples/config.env.example
#
# Copy this file, edit the values for your machine's role, then run:
#   sudo ./bin/harden.sh --config my-machine.env
#
# Any variable left unset here will fall back to an interactive prompt.
# Every value is the literal string "yes" or "no" unless noted otherwise.

# --- Service role ---
WANT_SAMBA=no
WANT_FTP=no
WANT_SSH=yes
WANT_TELNET=no
WANT_MAIL=no
WANT_PRINTING=no
WANT_MYSQL=no
WANT_HTTP=no
WANT_DNS=no
ALLOW_MEDIA_FILES=yes

# --- Optional hardening toggles ---
DISABLE_IPV6=no
DISABLE_REMOVABLE_MEDIA=no

# --- SSH ---
# Space-separated list of the only accounts allowed to log in over SSH.
# Leave unset to allow any account with a valid key.
#SSH_ALLOWED_USERS="alice bob"

# Defaults to "yes" so a team without pre-provisioned SSH keys cannot lock
# itself out mid-round. Switch to "no" only after keys are in place.
SSH_PASSWORD_AUTH=yes

# --- Monitoring (both default off to keep a run fast; see docs/security-controls.md) ---
# ClamAV + freshclam can take a long time on a slow connection.
INSTALL_CLAMAV=no
# rkhunter/chkrootkit scans are read-only but can take several minutes.
RUN_BASELINE_SCAN=no

# --- Accounts ---
# Overrides the baseline password assigned to reviewed/created accounts.
# CHANGE THIS. The in-repo default is a placeholder, not a secret.
HARDEN_DEFAULT_PASSWORD="ChangeMe!2024"

# --- Automation ---
# Set to 1 to purge known-risky packages (nmap, netcat, hydra, etc.)
# without an interactive per-package confirmation.
AUTO_APPROVE=0
